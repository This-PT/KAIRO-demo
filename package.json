{
  "name": "kairo",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "test": "dotenv -- vitest run",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:migrate": "dotenv -- pnpm --filter @kairo/db exec prisma migrate dev",
    "db:generate": "dotenv -- pnpm --filter @kairo/db exec prisma generate",
    "db:deploy": "dotenv -- pnpm --filter @kairo/db exec prisma migrate deploy",
    "web": "dotenv -- pnpm --filter @kairo/web dev",
    "api": "dotenv -- pnpm --filter @kairo/api start",
    "setup": "tsx scripts/setup-env.ts",
    "demo": "dotenv -- tsx apps/api/src/demo-cli.ts",
    "infra": "docker compose up -d && pnpm db:deploy",
    "web:build": "dotenv -- pnpm --filter @kairo/web build",
    "web:prod": "dotenv -- pnpm --filter @kairo/web start",
    "demo:showcase": "dotenv -- tsx apps/api/src/demo-cli.ts --showcase --reset",
    "demo:start": "tsx scripts/demo-start.ts",
    "demo:export": "dotenv -- tsx apps/api/src/export-cli.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:site": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}