# --- Database / queue ---
DATABASE_URL=postgresql://handover:handover@127.0.0.1:5432/handover
REDIS_URL=redis://127.0.0.1:6379

# --- Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# --- LLM: mock (offline, no key) | openai | anthropic ---
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: any OpenAI-compatible server (Gemini, Groq, local Ollama...), e.g. http://localhost:11434/v1
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Security ---
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# at least 12 chars; generate: node -e "console.log(require('crypto').randomBytes(18).toString('hex'))"
ADMIN_TOKEN=
# true = serve the fake tickets in fixtures/ (no Jira needed). false = use the JIRA_* settings above.
DEMO_MODE=true

# --- API server ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
SUMMARIZE_CONCURRENCY=2

# --- Sharing a demo ---
# Password for the web app. Blank = no login (fine on localhost; a production server refuses to start serving without it).
APP_PASSWORD=
# true = visitors can read and ask questions, but cannot change anything.
DEMO_READONLY=false
# Max chat questions per day in read-only mode (default 200). Protects your AI bill.
CHAT_DAILY_LIMIT=

# --- Web app (server-side only; never exposed to the browser) ---
API_URL=http://127.0.0.1:4000
